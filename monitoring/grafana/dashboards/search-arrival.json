{
  "uid": "gamelog-search-arrival",
  "title": "게임 검색 · 단계별 RPS 시험",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "k6",
    "search"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "suite",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gamelog-k6-prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total, suite)",
          "refId": "suite"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "case",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gamelog-k6-prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total{suite=~\"$suite\"}, case)",
          "refId": "case"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "phase",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gamelog-k6-prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total{suite=~\"$suite\"}, phase)",
          "refId": "phase"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "누적 p95 응답 시간",
      "description": "실행별 누적 p95. 중단 판단의 최근 30초 p95는 results의 rolling_windows에 별도 저장하며 이 값과 다릅니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_http_req_duration_p95{suite=~\"$suite\",case=~\"$case\",phase=~\"$phase\"}",
          "legendFormat": "{{case}} {{target_rps}} RPS {{phase}} {{testid}} {{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "누적 HTTP 실패율",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_http_req_failed_rate{suite=~\"$suite\",case=~\"$case\",phase=~\"$phase\"}",
          "legendFormat": "{{case}} {{target_rps}} RPS {{phase}} {{testid}} {{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "실제 처리량 · 최근 20초",
      "description": "전체 실행 평균과 다릅니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(k6_http_reqs_total{suite=~\"$suite\",case=~\"$case\",phase=~\"$phase\"}[20s])",
          "legendFormat": "{{case}} {{target_rps}} RPS {{phase}} {{testid}} {{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"

{
  "uid": "gamelog-k6-related-fixed",
  "title": "k6 상세 연관 추천 · 고정 10 VU",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "k6",
    "gamelog",
    "recommendations",
    "fixed-10vu"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "테스트 실행",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gamelog-k6-prometheus"
        },
        "query": {
          "query": "label_values(k6_http_reqs_total{profile=\"fixed-10vu\",scenario=~\"related\",phase=\"measurement\"}, run_id)",
          "refId": "run_id"
        },
        "refresh": 1,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "related-01",
          "value": "related-01"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users · 선택 실행 전체 구간",
      "description": "워밍업 포함. 본측정 시작 전에도 10 VU가 유지됩니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_vus{profile=\"fixed-10vu\",run_id=\"$run_id\"}",
          "legendFormat": "VUs",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Request Rate · 본측정 / 최근 20초",
      "description": "선택한 추천 API의 k6 완료 요청률. setup·워밍업 제외. 최초 20초는 표본 부족으로 비어 있을 수 있습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario) (rate(k6_http_reqs_total{profile=\"fixed-10vu\",run_id=\"$run_id\",phase=\"measurement\",scenario=~\"related\"}[20s]))",
          "legendFormat": "{{scenario}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "P95 / P99 · 본측정 / HTTP 200",
      "description": "본측정에서 성공한 HTTP 200 응답의 누적 백분위수. 짧은 구간별 통계가 아닙니다. 서로 다른 시계열의 백분위수를 평균내지 않습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_http_req_duration_p95{profile=\"fixed-10vu\",run_id=\"$run_id\",phase=\"measurement\",scenario=~\"related\",status=\"200\"}",
          "legendFormat": "{{scenario}} P95",
          "range": true
        },
        {
          "refId": "B",
          "expr": "k6_http_req_duration_p99{profile=\"fixed-10vu\",run_id=\"$run_id\",phase=\"measurement\",scenario=~\"related\",status=\"200\"}",
          "legendFormat": "{{scenario}} P99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP Error Rate · 본측정 / 최근 20초",
      "description": "k6 HTTP 실패 건수 / 전체 요청 수. 응답 본문 check 실패율과 별개이며 요청이 없으면 비어 있습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (scenario) (rate(k6_http_reqs_total{profile=\"fixed-10vu\",run_id=\"$run_id\",phase=\"measurement\",scenario=~\"related\",expected_response=\"false\"}[20s]))) or (sum by (scenario) (rate(k6_http_reqs_total{profile=\"fixed-10vu\",run_id=\"$run_id\",phase=\"measurement\",scenario=~\"related\"}[20s])) * 0)) / (sum by (scenario) (rate(k6_http_reqs_total{profile=\"fixed-10vu\",run_id=\"$run_id\",phase=\"measurement\",scenario=~\"related\"}[20s])))",
          "legendFormat": "{{scenario}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Application CPU · 서버 전체",
      "description": "서버 지표에는 run_id가 없습니다. 선택한 시간 범위의 서버 전체 활동입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"gamelog\"}",
          "legendFormat": "{{instance}} CPU",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "JVM Memory · 서버 전체",
      "description": "서버 지표에는 run_id가 없습니다. 추천 외 작업도 포함하므로 실행 시간대를 맞추세요.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamelog-k6-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, area) (jvm_memory_used_bytes{job=\"gamelog\"})",
          "legendFormat": "{{instance}} {{area}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
